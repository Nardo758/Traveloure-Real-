{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traveloure/audits/action-effect.schema.json",
  "title": "Action→Effect matrix row set (schema v1 — keep stable: future CI conformance-gate input)",
  "type": "object",
  "required": ["schemaVersion", "baseSha", "generatedAt", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseSha": { "type": "string" },
    "generatedAt": { "type": "string" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tier", "surface", "route", "component", "label", "trigger", "conditions", "chain", "ui", "verdict"],
        "properties": {
          "id": { "type": "string", "description": "stable id: <surface-slug>:<testid-or-label-slug>[:<n>]" },
          "tier": { "enum": [1, 2] },
          "intent": { "type": ["string", "null"], "description": "normalised user intent, e.g. add_to_plan, create_plan, open_planner, sign_in, book_via_agent, checkout, navigate" },
          "surface": { "type": "string" },
          "route": { "type": "string", "description": "mounted route pattern, or 'global'" },
          "component": { "type": "object", "required": ["name", "loc"], "properties": { "name": { "type": "string" }, "loc": { "type": "string", "description": "file:line" } } },
          "label": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "ariaLabel": { "type": ["string", "null"] }, "testId": { "type": ["string", "null"] } } },
          "trigger": {
            "type": "object", "required": ["kind", "loc"],
            "properties": {
              "kind": { "enum": ["click", "link", "submit", "input", "modal-lifecycle", "effect", "url-consumer", "auth-resume", "keyboard"] },
              "loc": { "type": "string" }
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object", "required": ["axis", "value", "outcome"],
              "properties": {
                "axis": { "enum": ["auth", "tripContext", "market", "none"] },
                "value": { "type": "string", "description": "auth: guest|authed|signs-in-mid-flow; tripContext: 0|1|2+|pen-bound|pen-unbound; market: preselected|none" },
                "outcome": { "type": "string" }
              }
            }
          },
          "chain": {
            "type": "object",
            "properties": {
              "handler": { "type": ["string", "null"], "description": "function name @ file:line" },
              "clientWrites": { "type": "array", "items": { "type": "string" }, "description": "store: key/field @ file:line" },
              "api": { "type": ["object", "null"], "properties": { "method": { "type": "string" }, "route": { "type": "string" }, "callLoc": { "type": "string" } } },
              "serverLoc": { "type": ["string", "null"] },
              "dbWrites": { "type": "array", "items": { "type": "string" }, "description": "table(columns)" },
              "sideEffects": { "type": "array", "items": { "type": "string" } },
              "invalidates": { "type": "array", "items": { "type": "string" }, "description": "react-query keys" },
              "navigates": { "type": ["string", "null"] },
              "downstreamReaders": { "type": "array", "items": { "type": "string" } }
            }
          },
          "ui": {
            "type": "object",
            "properties": {
              "uiPromise": { "type": ["string", "null"] },
              "feedback": { "type": "object", "properties": { "success": { "type": ["string", "null"] }, "failure": { "type": ["string", "null"] }, "loading": { "type": ["string", "null"] } } },
              "resultLocation": { "type": ["string", "null"] },
              "resultReachableFromSurface": { "type": ["boolean", "null"] },
              "wireframeRef": { "type": ["string", "null"] }
            }
          },
          "expected": { "type": ["string", "null"], "description": "spec/ruling reference" },
          "specRefs": {
            "type": "array", "description": "optional (closeout, additive): which spec governs this row and how",
            "items": { "type": "object", "required": ["doc", "relation"], "properties": {
              "doc": { "type": "string" }, "section": { "type": "string" },
              "relation": { "enum": ["governs", "upstream", "not_governed"] },
              "note": { "type": "string" }, "code": { "type": "string" } } }
          },
          "verdict": {
            "type": "object", "required": ["evidence", "gaps"],
            "properties": {
              "evidence": { "enum": ["behavioral", "static"] },
              "evidenceRef": { "type": ["string", "null"], "description": "journey step (J1/R5/step-13) or file:line" },
              "actual": { "type": ["string", "null"] },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "object", "required": ["class", "severity"],
                  "properties": {
                    "class": { "enum": ["DEAD_TRIGGER", "ORPHAN_WRITE", "ORPHAN_READ", "KEY_MISMATCH", "LIFECYCLE_LOSS", "AUTH_DROP", "STALE_CACHE", "SILENT_FAILURE", "SPEC_DIVERGENCE", "FALSE_PROMISE", "SILENT_SUCCESS", "SILENT_FAILURE_UI", "INVISIBLE_RESULT", "INCONSISTENT_AFFORDANCE", "WIREFRAME_DIVERGENCE"] },
                    "severity": { "enum": ["P1", "P2", "P3"] },
                    "note": { "type": "string" },
                    "rootCause": { "type": "string", "description": "optional (closeout, additive): GAP_REGISTER §A root-cause id, e.g. RC-12" },
                    "uiCheck": { "enum": ["CONFIRMED", "REFUTED", "BLOCKED", "NOT_PROVEN"], "description": "optional (Addendum 2 U2 / closeout): browser re-check verdict" },
                    "uiEvidence": { "type": "string" },
                    "uiObserved": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
