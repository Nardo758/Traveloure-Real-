modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip", "psmisc", "stripe-cli"]

[env]
PORT = "5000"
# ─── RESTORED 2026-09-22 (ledger `2026-09-22-replit-env-vars-restored`) ─────────────────────
# BOTH vars below were dropped on 2026-08-16 by `e9511082b`, whose subject is about console
# conformance screenshots — the removal was collateral and unrelated to that commit's purpose.
# Neither absence raised an error, which is why five weeks passed: one degrades to a scrubbed
# lockfile, the other to an honest warning. Do not remove either without a ledger row saying why.
#
# Lockfile-purity, source-level fix (Aug 11, 2026 — see CLAUDE.md "Lockfile purity"):
# Replit injects an env-level npm registry override pointing at its package-firewall
# proxy, which OUTRANKS the project .npmrc (npm precedence: env > project file) and
# bakes unreachable package-firewall.replit.local URLs into package-lock.json.
# Verified the firewall is advisory, not mandatory (direct registry.npmjs.org
# returns 200 from the workspace shell), so pinning the registry here prevents
# pollution from FORMING. The postinstall scrub + hooks + CI gate remain as
# defense-in-depth if this env route ever loses precedence again.
# LOWERCASE key, deliberately (verified Aug 11): Replit injects lowercase
# npm_config_registry, and with BOTH spellings present npm resolved the collision
# in the lowercase one's favor (uppercase NPM_CONFIG_REGISTRY was in env and lost).
# Same key = one value at the OS level; whichever layer sets it last wins.
npm_config_registry = "https://registry.npmjs.org/"
# R4 deliverable rail: the object-storage wrapper (server/infrastructure/
# object-storage.ts) reads this env var. Platform auto-injection of this name was
# assumed but never observed (verified absent after [env] re-application, Aug 11),
# so it is set here explicitly. Value mirrors [objectStorage].defaultBucketID
# below — keep the two in sync if the bucket is ever re-provisioned.
REPLIT_OBJECT_STORAGE_BUCKET = "replit-objstore-b9da6238-639b-4b0e-8956-034ec0042760"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start"]
# Ledger `2026-09-06-publish-preflight`: the DEPLOYMENT build is `build:prod`, which is
# `node scripts/publish-preflight.cjs --strict && npm run build`. The preflight refuses to
# build unless this workspace is a clean `main` at `origin/main` with a pure lockfile — the
# 2026-09-06 incident published 96c39f5 from a checkout carrying an unmerged local commit.
# CI and `npm run dev` are untouched: they run `npm run build` / `dev`, where the preflight
# is never invoked at all. Do not change this back to `npm run build`.
build = ["npm", "run", "build:prod"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-noop-migrations"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-field-guide-preview.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "check-noop-migrations"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/check-noop-migrations.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_anthropic:1.0.0", "javascript_xai:1.0.0", "javascript_stripe:1.0.0"]

[userenv]

[userenv.shared]
TWELVEGO_AFFILIATE_ID = "13805109"
VITE_TWELVEGO_AFFILIATE_ID = "13805109"
ADMIN_ALLOWED_IPS = "127.0.0.1"
PARTNERIZE_PUBLISHER_ID = "1101l337068"

[userenv.development]
VITE_STRIPE_PUBLISHABLE_KEY = "pk_test_51TzOTXRJlh67IHOHszuZ0udMBCCMZsTfRQ8xyQxxD0HrQqPPSz5NFplGzBE1IKK8DDStRI8IzRw8VuFulhoDeIcL00Z5enB7tt"
# STRIPE_SECRET_KEY_TEST lives in Replit Secrets — never in git (a committed value
# reached the PR-498 branch on Aug 17; rotate that key).
RATE_LIMIT_LOOPBACK_SKIP = "1"
DMO_INGEST_ENABLED = "0"

[userenv.production]
ENVIRONMENT = "PROD"
PLUS_SALES_ENABLED = "false"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20087
externalPort = 3001

[[ports]]
localPort = 23435
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 3003

[objectStorage]
defaultBucketID = "replit-objstore-b9da6238-639b-4b0e-8956-034ec0042760"
