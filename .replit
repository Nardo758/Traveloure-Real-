modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip", "psmisc"]

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-noop-migrations"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-claims-only-lookups"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "STRIPE_SECRET_KEY=\"$(node scripts/dev-stripe-key.cjs)\" npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "check-noop-migrations"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/check-noop-migrations.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-claims-only-lookups"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-claims-only-user-lookups.cjs"

[agent]
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_anthropic:1.0.0", "javascript_xai:1.0.0", "javascript_stripe:1.0.0"]

[userenv]

[userenv.shared]
TWELVEGO_AFFILIATE_ID = "13805109"
VITE_TWELVEGO_AFFILIATE_ID = "13805109"
ADMIN_ALLOWED_IPS = "127.0.0.1"
PARTNERIZE_PUBLISHER_ID = "1101l337068"

[userenv.development]
VITE_STRIPE_PUBLISHABLE_KEY = "pk_test_51TzOTXRJlh67IHOHszuZ0udMBCCMZsTfRQ8xyQxxD0HrQqPPSz5NFplGzBE1IKK8DDStRI8IzRw8VuFulhoDeIcL00Z5enB7tt"
STRIPE_SECRET_KEY_TEST = "[redacted]"

[userenv.production]
ENVIRONMENT = "PROD"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[objectStorage]
defaultBucketID = "replit-objstore-b9da6238-639b-4b0e-8956-034ec0042760"
