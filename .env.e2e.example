# Copy to `.env.e2e` (gitignored) and fill in. Used by playwright.e2e.config.ts,
# playwright.e2e.public.config.ts + e2e/global-setup.ts. Requires `npm i -D dotenv`
# for auto-loading, or export these into your shell before running.

# ── TWO TARGETS, DELIBERATELY SPLIT (docs/STAGING.md) ────────────────────────
#
# AUTH-DEPENDENT runs (playwright.e2e.config.ts — logs in seeded accounts).
# MUST be a STAGING deploy provisioned with the test-account opt-in. Production
# purges @traveloure.test accounts on boot (PR #319 P0 fix), so an auth run
# against production always 401s in global-setup — that is the fix working.
E2E_STAGING_BASE_URL=https://<your-staging-replit-url>

# UNAUTHENTICATED production smoke (playwright.e2e.public.config.ts).
# Public routes + /health + /api/version + /api/ready only. No login.
E2E_BASE_URL=https://<your-production-replit-url>

# Seed password for the staging accounts — must match the E2E_TEST_PASSWORD the
# STAGING deployment itself carries (server/seeds/e2e-test-accounts.seed.ts
# hashes with it; default TestPass123! if unset on both sides).
E2E_TEST_PASSWORD=TestPass123!

# Optional per-role email overrides (defaults are the seeded *.traveloure.test accounts)
# E2E_TRAVELER_EMAIL=test-traveler-kyoto@traveloure.test
# E2E_EXPERT_EMAIL=kyoto-food@traveloure.test
# E2E_PROVIDER_EMAIL=kyoto-photography@traveloure.test
# E2E_EA_EMAIL=test-ea@traveloure.test
# E2E_ADMIN_EMAIL=test-admin@traveloure.test
