# Copy to `.env.e2e` (gitignored) and fill in. Used by playwright.e2e.config.ts
# + e2e/global-setup.ts. Requires `npm i -D dotenv` for auto-loading, or export
# these into your shell before running.

# Deployed app under test (your Replit deploy URL)
E2E_BASE_URL=https://<your-replit-url>

# Shared seed password (default matches playwright/fixtures/test-accounts.ts)
E2E_TEST_PASSWORD=TestPass123!

# Optional per-role email overrides (defaults are the seeded *.traveloure.test accounts)
# E2E_TRAVELER_EMAIL=test-traveler-nyc@traveloure.test
# E2E_EXPERT_EMAIL=test-travel-expert@traveloure.test
# E2E_PROVIDER_EMAIL=test-provider@traveloure.test
# E2E_EA_EMAIL=test-ea@traveloure.test
# E2E_ADMIN_EMAIL=test-admin@traveloure.test
