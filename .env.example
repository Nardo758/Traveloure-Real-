# Database
DATABASE_URL=postgresql://user:password@localhost:5432/traveloure

# Auth
REPLIT_DEPLOYMENT=1
# REPLIT_DB_URL is automatically set by Replit

# API Keys - External Services

# Google Maps & Places API (Required for venue search)
# Get your API key: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API, Geocoding API
# Server-side key (geocoding, Places):
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Client-side key for in-browser maps. Vite only exposes VITE_-prefixed vars
# to the browser, so this must be set separately — use the SAME value as
# GOOGLE_MAPS_API_KEY:
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Optional: Cloud-registered Map ID — only needed if you want Advanced Markers.
# When unset, maps fall back to standard markers automatically.
# VITE_GOOGLE_MAPS_MAP_ID=your_cloud_map_id_here

# SERP API (Optional - for additional search results)
# Get your API key: https://serpapi.com/
SERP_API_KEY=your_serp_api_key_here

# AI Services
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROK_API_KEY=your_grok_api_key_here

# Travel APIs
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
VIATOR_API_KEY=your_viator_api_key_here

# Travelpayouts (affiliate travel APIs — flights/hotels/cars/tours/transfers)
# Affiliate attribution marker for outbound Travelpayouts links/bookings. Falls
# back to the account's default marker (405110) when unset.
TRAVELPAYOUTS_MARKER=

# MONEY_MAP F-5 (dormant): rewrites the outbound Travelpayouts sub_id to a per-booking
# attribution token (marker.<bookingRequestId>) so the reconciliation matcher can adopt the
# REAL partner-reported commission on an exact match instead of ever estimating one. Stays
# OFF (unset/not "1") until a live echo test confirms Travelpayouts actually returns the
# suffixed sub_id verbatim on execute_query action rows — do not flip this on speculatively.
TP_SUBID_ATTRIBUTION=

# Stripe — payments (MONEY_MAP F-2)
# Webhook signing secrets: each is REQUIRED to verify its webhook's signature.
# An app with STRIPE_SECRET_KEY set but a webhook secret unset can accept
# payments but can't safely verify webhook deliveries — see server/validate-env.ts.
# From the Stripe Dashboard → Developers → Webhooks (POST /api/bookings/webhooks/stripe):
STRIPE_WEBHOOK_SECRET=
# From the Connect-events webhook endpoint (POST /api/webhooks/stripe):
STRIPE_CONNECT_WEBHOOK_SECRET=
# From the Identity-events webhook endpoint (POST /api/webhooks/stripe-identity):
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Persona KYC webhook signing secret (POST /api/webhooks/persona):
PERSONA_WEBHOOK_SECRET=
# Client-side Stripe publishable key (Vite only exposes VITE_-prefixed vars to
# the browser) — powers the Elements/Checkout UI in client/src/components/booking/StripeCheckout.tsx:
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional Services
PEXELS_API_KEY=your_pexels_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
FEVER_API_KEY=your_fever_api_key_here

# Facebook OAuth (Optional)
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback

# Server Configuration
PORT=5000
NODE_ENV=development
SLOW_QUERY_THRESHOLD_MS=500
