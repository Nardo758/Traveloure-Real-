# E2E (deploy harness) generated auth state
e2e/auth/
# Playwright per-role auth state files (written by globalSetup at runtime)
playwright/.auth/

# Agent/lane verification scratch (harness scripts written during behavioral proofs).
# Never commit these — proofs live in commit messages, not in the tree.
.scratch-lane/
# Same rule, for the ad-hoc screenshot harnesses lanes drop at the repo root
# (a running lane may still be using one, so ignore rather than delete).
.shots-*.mjs

# scripts/journeys/*.mjs output (§4b) — failing-step screenshots only, written to
# ./journey-out by default (overridable via --out / JOURNEY_OUT_DIR). Never commit;
# the verdict JSON/table in the run's stdout is the artifact that matters.
journey-out/

# Claude Code agent scratch (session-local: isolated agent worktrees, local settings) — never commit
.claude/
